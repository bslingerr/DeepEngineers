            <PCU>1</PCU>
        </Definition>
    </CubeBlocks>
    <CategoryClasses>
        <Category xsi:type="MyObjectBuilder_GuiBlockCategoryDefinition">
            <Id>
                <TypeId>GuiBlockCategoryDefinition</TypeId>
                <SubtypeId>DeepEngineers</SubtypeId>
            </Id>
            <DisplayName>DeepEngineers</DisplayName>
            <Name>DeepEngineers</Name>
            <ItemIds>
                <string>CubeBlock/DE_PressureHullMk1Large</string>
                <string>CubeBlock/DE_PressureHullMk1Small</string>
                <string>CubeBlock/DE_PressureHullMk2Large</string>
                <string>CubeBlock/DE_PressureHullMk2Small</string>
            </ItemIds>
        </Category>
    </CategoryClasses>
    <BlockVariantGroups>
        <BlockVariantGroup>
            <Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="DE_PressureHullMk1Group" />
            <Icon>Textures\GUI\Icons\Cubes\UpgradeEnergy.dds</Icon>
            <DisplayName>Pressure Hull Mk1</DisplayName>
            <Description>DeepEngineers: crush depth 1,400 m.</Description>
            <Blocks>
                <Block Type="MyObjectBuilder_CubeBlock" Subtype="DE_PressureHullMk1Large" />
                <Block Type="MyObjectBuilder_CubeBlock" Subtype="DE_PressureHullMk1Small" />
            </Blocks>
        </BlockVariantGroup>
        <BlockVariantGroup>
            <Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="DE_PressureHullMk2Group" />
            <Icon>Textures\GUI\Icons\Cubes\UpgradeEffectiveness.dds</Icon>
            <DisplayName>Pressure Hull Mk2</DisplayName>
            <Description>DeepEngineers: crush depth 2,000 m.</Description>
            <Blocks>
                <Block Type="MyObjectBuilder_CubeBlock" Subtype="DE_PressureHullMk2Large" />
                <Block Type="MyObjectBuilder_CubeBlock" Subtype="DE_PressureHullMk2Small" />
            </Blocks>
        </BlockVariantGroup>
    </BlockVariantGroups>
</Definitions>
