<?xml version="1.0" encoding="utf-8"?>
<!--
 DeepEngineers.World, S17 (docs/S17-BRIEF.md; CONTRACT section 5.4 "S17 conventions", kind rows): one blueprint per kind, 1 raw fish -> 1 cooked
 fish in 4 s, in the Food Processor's own blueprint class FoodProcessorRations (the class's input constraint is built from
 its blueprints' prerequisites after the definitions load: MyProductionBlockDefinition.LoadPostProcess / PrepareConstraint).
 Generated from the S17 Python twin's tables (tools/s17/s17_ref.py); checked by tools/worldmod/check_planet.py (s17.* rows,
 tools/worldmod/s17_food.py). Icons and models are the game's own raw / cooked meat by their content paths
 (MyDefinitionManager.ProcessContentFilePath: a path absent from the mod folder resolves to the game Content); no game asset
 is copied into this mod.
-->
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <Blueprints>
        <Blueprint>
            <Id>
                <TypeId>BlueprintDefinition</TypeId>
                <SubtypeId>DE_CookFish_Peeper</SubtypeId>
            </Id>
            <DisplayName>Cook Peeper</DisplayName>
            <Icon>Textures\GUI\Icons\Items\Meat_mammal_cooked.dds</Icon>
            <Prerequisites>
                <Item Amount="1" TypeId="ConsumableItem" SubtypeId="DE_Fish_Peeper_Raw" />
            </Prerequisites>
            <Results>
                <Item Amount="1" TypeId="ConsumableItem" SubtypeId="DE_Fish_Peeper_Cooked" />
            </Results>
            <BaseProductionTimeInSeconds>4</BaseProductionTimeInSeconds>
        </Blueprint>
