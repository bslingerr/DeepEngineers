<?xml version="1.0" encoding="utf-8"?>
<!--
 DeepEngineers.World, S17 (docs/S17-BRIEF.md; CONTRACT section 5.4 "S17 conventions", kind rows): the raw and cooked fish of the 4546B sea
 as SE consumables: one Food stat on SE's meal-pack scale (raw = MealPack_KelpCrisp, SE's smallest meal pack, 0.00267 per
 30 s; cooked twice that), no Health stat, mass and volume of a meal pack.
 Generated from the S17 Python twin's tables (tools/s17/s17_ref.py); checked by tools/worldmod/check_planet.py (s17.* rows,
 tools/worldmod/s17_food.py). Icons and models are the game's own raw / cooked meat by their content paths
 (MyDefinitionManager.ProcessContentFilePath: a path absent from the mod folder resolves to the game Content); no game asset
 is copied into this mod.
-->
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <PhysicalItems>
        <PhysicalItem xsi:type="MyObjectBuilder_ConsumableItemDefinition">
            <Id>
                <TypeId>ConsumableItem</TypeId>
                <SubtypeId>DE_Fish_Peeper_Raw</SubtypeId>
            </Id>
            <DisplayName>Peeper (raw)</DisplayName>
            <Description>DeepEngineers: a 4546B fish (Peeper), caught by hand in the sea of Subnautica. Edible raw; the Food Processor cooks it for twice the food.</Description>
            <Icon>Textures\GUI\Icons\Items\Meat_mammal_raw.dds</Icon>
            <Size>
                <X>0.15</X>
                <Y>0.15</Y>
                <Z>0.15</Z>
            </Size>
            <Mass>1.5</Mass>
            <Volume>1.25</Volume>
            <Model>Models\Items\Meat_mammal_raw.mwm</Model>
            <PhysicalMaterial>Metal</PhysicalMaterial>
            <Stats>
                <Stat Name="Food" Value="0.00267" Time="30" />
            </Stats>
            <UseSound>ArcPlayEat</UseSound>
            <IconSymbol>Item_Symbol_Raw</IconSymbol>
        </PhysicalItem>
        <PhysicalItem xsi:type="MyObjectBuilder_ConsumableItemDefinition">
            <Id>
                <TypeId>ConsumableItem</TypeId>
                <SubtypeId>DE_Fish_Peeper_Cooked</SubtypeId>
            </Id>
            <DisplayName>Peeper (cooked)</DisplayName>
            <Description>DeepEngineers: a 4546B fish (Peeper), cooked at the Food Processor.</Description>
            <Icon>Textures\GUI\Icons\Items\Meat_mammal_cooked.dds</Icon>
            <Size>
                <X>0.15</X>
                <Y>0.15</Y>
                <Z>0.15</Z>
            </Size>
            <Mass>1.5</Mass>
            <Volume>1.25</Volume>
            <Model>Models\Items\Meat_mammal_cooked.mwm</Model>
            <PhysicalMaterial>Metal</PhysicalMaterial>
            <Stats>
                <Stat Name="Food" Value="0.00534" Time="30" />
            </Stats>
            <UseSound>ArcPlayEat</UseSound>
            <IconSymbol>Item_Symbol_Cooked</IconSymbol>
        </PhysicalItem>
